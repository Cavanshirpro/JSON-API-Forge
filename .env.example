# JSON API Forge v0.4.1 environment template.
#
# Do NOT copy placeholder secrets from this file. Run:
#     forge init
# or:
#     python forge.py init
# The init command creates a gitignored .env with cryptographically random values.

APP_ENV=development
LOG_LEVEL=INFO

# Internal Forge security/audit/media metadata database.
INTERNAL_DATABASE_URL=sqlite+aiosqlite:///./data/internal-v4.db
# Use `validate` in production after an explicit `forge migrate`.
INTERNAL_SCHEMA_MODE=create
# Pool settings matter when INTERNAL_DATABASE_URL uses PostgreSQL/MySQL.
INTERNAL_POOL_PRE_PING=true
INTERNAL_POOL_SIZE=10
INTERNAL_MAX_OVERFLOW=20
INTERNAL_POOL_TIMEOUT=30
INTERNAL_POOL_RECYCLE=1800

# Project databases. SQLite defaults are already present in the example JSON configs;
# uncomment these when you want to override them.
# APP1_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/app1
# APP2_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/app2

# Generated by `forge init`; intentionally blank in the public template.
APP1_BOOTSTRAP_ADMIN_KEY=
APP2_BOOTSTRAP_ADMIN_KEY=
APP1_JWT_SECRET=
JWT_SECRET=
# Process-wide operational credential for metrics/detailed readiness.
# `forge init --production` generates this automatically.
OPERATOR_TOKEN=

# Required only when a project selects Redis cache/rate-limit/realtime backends.
REDIS_URL=

# Optional external JWT/JWKS provider (for example Supabase Auth).
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1

# Optional MongoDB project connection used only when configured.
# MONGODB_URL=mongodb://127.0.0.1:27017
