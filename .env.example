APP_ENV=development
CONFIG_DIR=app/config
BOOTSTRAP_ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
INTERNAL_DATABASE_URL=sqlite+aiosqlite:///./data/internal.db
PRIMARY_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL example:
# PRIMARY_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
# Supabase example (use pooler/direct URL supplied by Supabase):
# PRIMARY_DATABASE_URL=postgresql+asyncpg://postgres.project:password@host:6543/postgres
# MySQL example:
# MYSQL_DATABASE_URL=mysql+asyncmy://user:password@host:3306/database
REDIS_URL=
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false
