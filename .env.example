APP_ENV=development
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false

# Internal Forge security/audit/media metadata database.
INTERNAL_DATABASE_URL=sqlite+aiosqlite:///./data/internal-v3.db

# Project databases. Replace with PostgreSQL/MySQL URLs in production.
APP1_DATABASE_URL=sqlite+aiosqlite:///./data/app1.db
APP2_DATABASE_URL=sqlite+aiosqlite:///./data/app2.db

# Project-scoped bootstrap credentials. Generate long random values.
APP1_BOOTSTRAP_ADMIN_KEY=change-me-app1
APP2_BOOTSTRAP_ADMIN_KEY=change-me-app2

# JWT secret shared by the runtime. Tokens are project-bound by claim.
JWT_SECRET=change-me-long-jwt-secret

# Required for Redis cache/rate limiting modes.
REDIS_URL=redis://127.0.0.1:6379/0

# Optional external JWT/JWKS provider (for example Supabase Auth).
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1

# Optional MongoDB project connection used only when configured.
# MONGODB_URL=mongodb://127.0.0.1:27017
