{
  "$schema": "../../../schemas/fragment.schema.json",
  "security": {
    "bootstrap_admin_key": "$env:APP1_BOOTSTRAP_ADMIN_KEY",
    "api_key_header": "X-API-Key",
    "jwt_enabled": true,
    "allow_query_api_key": false,
    "require_https": false
  },
  "roles": {
    "admin": {
      "permissions": [
        "*"
      ]
    },
    "plugin": {
      "permissions": [
        "notes.list",
        "notes.read",
        "system.meta.read"
      ]
    },
    "media_uploader": {
      "permissions": [
        "media.upload",
        "media.read"
      ]
    },
    "social_client": {
      "permissions": [
        "social.*",
        "media.read",
        "media.upload"
      ]
    },
    "game_client": {
      "permissions": [
        "gaming.*",
        "system.meta.read"
      ]
    },
    "economy_bot": {
      "permissions": [
        "system.meta.read",
        "economy.balance.read",
        "economy.transfer",
        "economy.accounts.read",
        "economy.ledger.read"
      ]
    },
    "economy_admin": {
      "permissions": [
        "economy.*",
        "admin.keys.list",
        "system.meta.read"
      ]
    },
    "content_plugin": {
      "permissions": [
        "content.catalog"
      ]
    },
    "realtime_client": {
      "permissions": [
        "events.notifications.subscribe",
        "events.notifications.publish"
      ]
    }
  }
}
