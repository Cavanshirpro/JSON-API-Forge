{
  "$schema": "../../../schemas/fragment.schema.json",
  "cache": {
    "enabled": true,
    "backend": "memory",
    "default_ttl_seconds": 15,
    "max_entries": 10000
  },
  "rate_limit": {
    "enabled": true,
    "backend": "memory",
    "requests": 300,
    "window_seconds": 60,
    "burst": 75,
    "route_requests": 120,
    "route_window_seconds": 60,
    "route_burst": 30
  },
  "protection": {
    "max_request_body_bytes": 262144,
    "max_concurrent_requests": 120,
    "request_timeout_seconds": 15,
    "trusted_hosts": ["*"]
  }
}
