{
  "$schema": "../../schemas/fragment.schema.json",
  "security": {
    "jwt_enabled": true,
    "jwt_provider": "jwks",
    "jwt_jwks_url": "$env:SUPABASE_JWKS_URL",
    "jwt_issuer": "$env:SUPABASE_JWT_ISSUER",
    "jwt_audience": "authenticated",
    "jwt_algorithms": ["ES256", "RS256"],
    "jwt_subject_claim": "sub",
    "jwt_roles_claim": "app_metadata.roles",
    "jwt_permissions_claim": "app_metadata.permissions",
    "jwt_tenant_claim": "app_metadata.tenant_id",
    "jwks_cache_ttl_seconds": 600
  }
}
